# Private BLS staking/consensus key.
# Mandatory: yes if you are not using ESPRESSO_NODE_KEY_FILE.
ESPRESSO_NODE_PRIVATE_STAKING_KEY=BLS_SIGNING_KEY~hwmM7PbDDu8eX1Adi-e

# Private Schnorr state key.
# Mandatory: yes if you are not using ESPRESSO_NODE_KEY_FILE.
ESPRESSO_NODE_PRIVATE_STATE_KEY=SCHNORR_SIGNING_KEY~PEDbG
